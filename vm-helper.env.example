# Optional machine-local overrides for vm-helper.
# Copy to vm-helper.env, or run: ./vm-helper configure

# Leave VM empty to auto-select when libvirt has exactly one domain.
VM=""
URI="qemu:///system"

# Leave empty to discover the first raw block disk from the VM definition.
# File-backed VMs do not need this value.
WIN_DISK=""

# Leave empty to discover display-class PCI host devices from the VM XML.
# Include the GPU and every companion function assigned to the VM.
GPU_PCI=()

# Leave empty to infer host modules from the selected GPU vendor/driver.
GPU_MODULES=()

# Leave empty with USB_AUTO_DISCOVER=1 to read USB host devices from VM XML.
# Entries use: "Label|vendor_id|product_id".
USB_DEVICES=()
USB_AUTO_DISCOVER=1

READY_DELAY=8
SHUTDOWN_TIMEOUT=300
REATTACH_TIMEOUT=20
NVIDIA_SMI_TIMEOUT=10

# Set to 1 only when intentionally stopping a graphical session from within it.
ALLOW_GUI=0
