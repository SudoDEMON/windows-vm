# Copy to vm-helper.env and customize for a host.
# This file is Bash syntax and is sourced by the helper scripts.

VM="win11-basic"
URI="qemu:///system"

# Stable raw Windows disk path. Prefer /dev/disk/by-id over /dev/sdX.
WIN_DISK="/dev/disk/by-id/CHANGE-ME-WINDOWS-DISK"

# GPU PCI functions passed through to Windows.
GPU_PCI=("0000:01:00.0" "0000:01:00.1")

# Libvirt node-device names for reattaching GPU functions to Linux.
GPU_NODE=("pci_0000_01_00_0" "pci_0000_01_00_1")

# Required Windows USB devices: "Label|vendor_id|product_id".
REQUIRED_USB=(
  "Wooting 60HE|31e3|1312"
  "Logitech G305 receiver|046d|c53f"
  "SteelSeries Nova Pro Wireless|1038|12e5"
)

# linux-vm waits this many seconds after VM/GPU readiness before starting display-manager.
READY_DELAY=8

# linux4090 waits this many seconds for graceful VM shutdown.
SHUTDOWN_TIMEOUT=300

# Set to 1 only when intentionally running windows4090 from an active graphical session.
ALLOW_GUI=0
