#!/usr/bin/env bash
set -Eeuo pipefail

ENTRYPOINT="$(basename "${BASH_SOURCE[0]}")"
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CONFIG_FILE="${VM_MANAGER_CONFIG:-$ROOT/vm-helper.env}"

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

VM="${VM:-}"
URI="${URI:-qemu:///system}"
WIN_DISK="${WIN_DISK:-}"
ALLOW_GUI="${ALLOW_GUI:-0}"
READY_DELAY="${READY_DELAY:-8}"
SHUTDOWN_TIMEOUT="${SHUTDOWN_TIMEOUT:-300}"
REATTACH_TIMEOUT="${REATTACH_TIMEOUT:-20}"
NVIDIA_SMI_TIMEOUT="${NVIDIA_SMI_TIMEOUT:-10}"
USB_AUTO_DISCOVER="${USB_AUTO_DISCOVER:-1}"
MACHINE_PROTOCOL_VERSION=1
MUTATION_LOCK_DEPTH=0
MUTATION_LOCK_FD=""

if ! declare -p GPU_PCI >/dev/null 2>&1; then declare -a GPU_PCI=(); fi
if ! declare -p GPU_MODULES >/dev/null 2>&1; then declare -a GPU_MODULES=(); fi
if ! declare -p USB_DEVICES >/dev/null 2>&1; then
  declare -a USB_DEVICES=()
  if declare -p REQUIRED_USB >/dev/null 2>&1; then USB_DEVICES=("${REQUIRED_USB[@]}"); fi
fi

VM_XML=""
TEMP_FILES=()
VM_RAW_DISKS=()
SUDO_KEEPALIVE_PID=""
WORKER_RUNTIME_DIR=""
WORKER_OWNER_UID=""

cleanup() {
  if [[ -n "$SUDO_KEEPALIVE_PID" ]]; then
    kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    SUDO_KEEPALIVE_PID=""
  fi
  ((${#TEMP_FILES[@]} == 0)) || rm -f -- "${TEMP_FILES[@]}"
}
trap cleanup EXIT

log() { printf '[vm-helper] %s\n' "$*"; }
warn() { printf '[vm-helper] WARNING: %s\n' "$*" >&2; }
die() { printf '[vm-helper] ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }
read_file() { [[ -r "$1" ]] && cat -- "$1" || true; }

runtime_dir() {
  local base="${XDG_RUNTIME_DIR:-}"
  if [[ -n "$WORKER_RUNTIME_DIR" ]]; then printf '%s' "$WORKER_RUNTIME_DIR"; return; fi
  if [[ -z "$base" && -d "/run/user/$UID" ]]; then base="/run/user/$UID"; fi
  if [[ -z "$base" ]]; then base="${TMPDIR:-/tmp}/vm-helper-$UID"; fi
  printf '%s/vm-helper' "$base"
}

ensure_runtime_dir() {
  local dir expected_uid actual_uid mode
  dir="$(runtime_dir)"
  expected_uid="${WORKER_OWNER_UID:-$UID}"
  if [[ -n "$WORKER_RUNTIME_DIR" ]]; then
    [[ -d "$dir" && ! -L "$dir" ]] || die "worker runtime directory is invalid: $dir"
  else
    mkdir -p -- "$dir"
    chmod 700 -- "$dir"
  fi
  actual_uid="$(stat -c %u -- "$dir" 2>/dev/null || true)"
  mode="$(stat -c %a -- "$dir" 2>/dev/null || true)"
  [[ "$actual_uid" == "$expected_uid" ]] || die "runtime directory has unexpected owner: $dir"
  [[ "$mode" == 700 ]] || die "runtime directory must have mode 0700: $dir"
  printf '%s' "$dir"
}

protocol_begin() { printf 'VMH%s\0' "$MACHINE_PROTOCOL_VERSION"; }

protocol_record() {
  local kind="$1"; shift
  printf '%s\0%d\0' "$kind" "$#"
  (($# == 0)) || printf '%s\0' "$@"
}

with_mutation_lock() {
  local dir lock_file rc=0
  if ((MUTATION_LOCK_DEPTH > 0)); then "$@"; return; fi
  need flock
  dir="$(ensure_runtime_dir)"; lock_file="$dir/mutation.lock"
  exec {MUTATION_LOCK_FD}>"$lock_file"
  chmod 600 -- "$lock_file"
  if ! flock -n "$MUTATION_LOCK_FD"; then
    exec {MUTATION_LOCK_FD}>&-
    die "another VM/GPU/USB/configuration mutation is already active"
  fi
  MUTATION_LOCK_DEPTH=1
  if "$@"; then rc=0; else rc=$?; fi
  MUTATION_LOCK_DEPTH=0
  flock -u "$MUTATION_LOCK_FD" || true
  exec {MUTATION_LOCK_FD}>&-
  return "$rc"
}

as_root() {
  if ((EUID == 0)); then "$@"; else sudo -n "$@"; fi
}

begin_root_session() {
  ((EUID != 0)) || return 0
  if [[ -n "$SUDO_KEEPALIVE_PID" ]] && kill -0 "$SUDO_KEEPALIVE_PID" 2>/dev/null; then return 0; fi

  if ! sudo -n true 2>/dev/null; then
    [[ -t 0 ]] || die "sudo authorization is required; rerun from an interactive TTY"
    log "authorizing privileged device and display-manager operations"
    sudo -v || die "sudo authorization failed"
  fi
  sudo -n true 2>/dev/null \
    || die "sudo credentials cannot be reused non-interactively; no devices were changed"

  (
    while sleep 20; do sudo -n -v >/dev/null 2>&1 || exit; done
  ) &
  SUDO_KEEPALIVE_PID=$!
}

domstate() {
  virsh -c "$URI" domstate "$VM" 2>/dev/null
}

required_domstate() {
  local state
  state="$(domstate)" || die "could not read state for $VM at $URI"
  [[ -n "$state" ]] || die "libvirt returned an empty state for $VM at $URI"
  printf '%s' "$state"
}

driver_for() {
  local link="/sys/bus/pci/devices/$1/driver"
  if [[ -L "$link" ]]; then basename "$(readlink -f "$link")"; else printf 'none'; fi
}

uevent_driver_for() {
  awk -F= '$1 == "DRIVER" {print $2; exit}' "/sys/bus/pci/devices/$1/uevent" 2>/dev/null || true
}

node_for_pci() {
  printf 'pci_%s' "${1//[:.]/_}"
}

iommu_group_for() {
  local link="/sys/bus/pci/devices/$1/iommu_group"
  [[ -L "$link" ]] && basename "$(readlink -f "$link")" || printf 'none'
}

pci_label() {
  lspci -D -s "$1" 2>/dev/null | sed 's/^[^ ]* //' || printf 'unknown PCI device'
}

usb_label() {
  local want_vid="${1,,}" want_pid="${2,,}" dev vid pid manufacturer product
  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    vid="$(<"$dev/idVendor")"; pid="$(<"$dev/idProduct")"
    [[ "$vid" == "$want_vid" && "$pid" == "$want_pid" ]] || continue
    manufacturer="$(read_file "$dev/manufacturer")"
    product="$(read_file "$dev/product")"
    printf '%s' "${manufacturer:+$manufacturer }${product:-USB $vid:$pid}"
    return 0
  done
  printf 'USB %s:%s' "$want_vid" "$want_pid"
}

usb_present() {
  local want_vid="${1,,}" want_pid="${2,,}" dev
  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    [[ "$(<"$dev/idVendor")" == "$want_vid" && "$(<"$dev/idProduct")" == "$want_pid" ]] && return 0
  done
  return 1
}

usb_device_count() {
  local want_vid="${1,,}" want_pid="${2,,}" dev count=0
  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    [[ "$(<"$dev/idVendor")" == "$want_vid" && "$(<"$dev/idProduct")" == "$want_pid" ]] \
      && ((count += 1))
  done
  printf '%s' "$count"
}

usb_path_is_hub() {
  local dev="$1" interface
  [[ "${2:-$(read_file "$dev/bDeviceClass")}" != 09 ]] || return 0
  for interface in "$dev":*; do
    [[ -r "$interface/bInterfaceClass" ]] || continue
    [[ "$(<"$interface/bInterfaceClass")" != 09 ]] || return 0
  done
  return 1
}

usb_id_is_hub() {
  local want_vid="${1,,}" want_pid="${2,,}" dev
  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    [[ "$(<"$dev/idVendor")" == "$want_vid" && "$(<"$dev/idProduct")" == "$want_pid" ]] || continue
    usb_path_is_hub "$dev" && return 0
  done
  return 1
}

resolve_vm() {
  local output
  local -a domains=()
  if [[ -n "$VM" ]]; then
    virsh -c "$URI" dominfo "$VM" >/dev/null 2>&1 \
      || die "configured VM '$VM' was not found at $URI"
    return 0
  fi
  output="$(virsh -c "$URI" list --all --name)" \
    || die "could not list libvirt domains at $URI"
  mapfile -t domains < <(awk 'NF' <<<"$output")
  if ((${#domains[@]} == 1)); then
    VM="${domains[0]}"
    log "auto-selected the only libvirt domain: $VM"
    return 0
  fi
  die "VM is not configured and ${#domains[@]} libvirt domains were found. Run '$SCRIPT_PATH configure'."
}

xml_value() {
  local xpath="$1"
  xmllint --xpath "string($xpath)" - 2>/dev/null <<<"$VM_XML" || true
}

xml_count() {
  xmllint --xpath "count($1)" - 2>/dev/null <<<"$VM_XML" || printf '0'
}

discover_gpu_from_vm() {
  local count index domain bus slot function bdf class prefix item
  local -a hostdevs=() gpu_slots=()
  count="$(xml_count '/domain/devices/hostdev[@type="pci"]/source/address')"
  for ((index=1; index<=count; index++)); do
    domain="$(xml_value "(/domain/devices/hostdev[@type='pci']/source/address)[$index]/@domain")"
    bus="$(xml_value "(/domain/devices/hostdev[@type='pci']/source/address)[$index]/@bus")"
    slot="$(xml_value "(/domain/devices/hostdev[@type='pci']/source/address)[$index]/@slot")"
    function="$(xml_value "(/domain/devices/hostdev[@type='pci']/source/address)[$index]/@function")"
    printf -v bdf '%04x:%02x:%02x.%x' "$domain" "$bus" "$slot" "$function"
    hostdevs+=("$bdf")
    class="$(read_file "/sys/bus/pci/devices/$bdf/class")"
    [[ "$class" == 0x03* ]] && gpu_slots+=("${bdf%.*}")
  done
  for item in "${hostdevs[@]}"; do
    prefix="${item%.*}"
    for slot in "${gpu_slots[@]}"; do
      [[ "$prefix" == "$slot" ]] && GPU_PCI+=("$item") && break
    done
  done
}

discover_usb_from_vm() {
  local count index vid pid label
  count="$(xml_count '/domain/devices/hostdev[@type="usb"]/source[vendor and product]')"
  for ((index=1; index<=count; index++)); do
    vid="$(xml_value "(/domain/devices/hostdev[@type='usb']/source)[$index]/vendor/@id")"
    pid="$(xml_value "(/domain/devices/hostdev[@type='usb']/source)[$index]/product/@id")"
    vid="${vid#0x}"; pid="${pid#0x}"
    label="$(usb_label "$vid" "$pid")"
    USB_DEVICES+=("$label|$vid|$pid")
  done
}

discover_disks_from_vm() {
  local count index disk
  VM_RAW_DISKS=()
  count="$(xml_count "/domain/devices/disk[@type='block' and @device='disk']/source[@dev]")"
  for ((index=1; index<=count; index++)); do
    disk="$(xml_value "(/domain/devices/disk[@type='block' and @device='disk']/source[@dev])[$index]/@dev")"
    [[ -n "$disk" ]] && VM_RAW_DISKS+=("$disk")
  done
}

same_device_path() {
  local left="$1" right="$2" left_real right_real
  [[ "$left" == "$right" ]] && return 0
  left_real="$(readlink -f -- "$left" 2>/dev/null || true)"
  right_real="$(readlink -f -- "$right" 2>/dev/null || true)"
  [[ -n "$left_real" && "$left_real" == "$right_real" ]]
}

validate_configured_disk() {
  local disk matched=0
  [[ -n "$WIN_DISK" ]] || return 0
  for disk in "${VM_RAW_DISKS[@]}"; do
    same_device_path "$WIN_DISK" "$disk" && matched=1
  done
  ((matched == 1)) || die "configured WIN_DISK is not a raw block disk attached to $VM: $WIN_DISK"
}

infer_gpu_modules() {
  local primary="${GPU_PCI[0]:-}" vendor driver
  [[ -n "$primary" ]] || return 0
  vendor="$(read_file "/sys/bus/pci/devices/$primary/vendor")"
  driver="$(driver_for "$primary")"
  case "$vendor" in
    0x10de)
      if modinfo nvidia >/dev/null 2>&1; then
        GPU_MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
      else
        GPU_MODULES=(nouveau)
      fi
      ;;
    0x1002) GPU_MODULES=(amdgpu) ;;
    0x8086)
      if [[ "$driver" == "xe" ]] || modinfo xe >/dev/null 2>&1; then GPU_MODULES=(xe); else GPU_MODULES=(i915); fi
      ;;
    *) [[ "$driver" != "none" && "$driver" != "vfio-pci" ]] && GPU_MODULES=("$driver") ;;
  esac
}

load_runtime_config() {
  local pci
  need virsh; need xmllint; need lspci
  resolve_vm
  VM_XML="$(virsh -c "$URI" dumpxml --inactive "$VM")" \
    || die "could not read inactive XML for $VM at $URI"
  discover_disks_from_vm
  validate_configured_disk
  ((${#GPU_PCI[@]} > 0)) || discover_gpu_from_vm
  ((${#GPU_PCI[@]} > 0)) || die "no passed-through display GPU was discovered for $VM; run '$SCRIPT_PATH configure'"
  for pci in "${GPU_PCI[@]}"; do
    [[ "$pci" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]$ ]] || die "invalid GPU PCI address: $pci"
    [[ -e "/sys/bus/pci/devices/$pci" ]] || die "configured GPU PCI function is missing: $pci"
  done
  ((${#GPU_MODULES[@]} > 0)) || infer_gpu_modules
  if ((${#USB_DEVICES[@]} == 0)) && [[ "$USB_AUTO_DISCOVER" == "1" ]]; then discover_usb_from_vm; fi
  [[ -n "$WIN_DISK" ]] || WIN_DISK="${VM_RAW_DISKS[0]:-}"
}

vm_has_pci_hostdev() {
  local pci="$1" domain bus slot function count
  domain="${pci%%:*}"; bus="${pci#*:}"; bus="${bus%%:*}"
  slot="${pci%.*}"; slot="${slot##*:}"; function="${pci##*.}"
  printf -v domain '0x%04x' "0x$domain"; printf -v bus '0x%02x' "0x$bus"
  printf -v slot '0x%02x' "0x$slot"; printf -v function '0x%x' "0x$function"
  count="$(xml_count "/domain/devices/hostdev[@type='pci']/source/address[@domain='$domain' and @bus='$bus' and @slot='$slot' and @function='$function']")"
  ((count > 0))
}

assert_pci_state_sane() {
  local pci="$1" linked uevent
  linked="$(driver_for "$pci")"; uevent="$(uevent_driver_for "$pci")"
  if [[ "$linked" == "none" && -n "$uevent" ]]; then
    die "$pci has stale driver state: uevent reports $uevent, but no driver is bound. Reboot before retrying."
  fi
  if [[ "$linked" != "none" && -n "$uevent" && "$linked" != "$uevent" ]]; then
    die "$pci has inconsistent driver state: sysfs reports $linked, uevent reports $uevent. Reboot before retrying."
  fi
}

check_raw_disks() {
  local disk diskdev state mounted
  if ((${#VM_RAW_DISKS[@]} == 0)); then
    log "$VM has no raw block disk; raw-disk safety checks are not needed."
    return 0
  fi
  for disk in "${VM_RAW_DISKS[@]}"; do
    [[ -e "$disk" ]] || die "VM raw disk is missing: $disk"
    diskdev="$(readlink -f -- "$disk")"
    [[ -b "$diskdev" ]] || die "raw disk did not resolve to a block device: $disk -> $diskdev"
    state="$(lsblk -dnro STATE "$diskdev" 2>/dev/null | awk 'NF && !found {value=$0; found=1} END {if (found) print value}')"
    [[ "$state" != "offline" ]] || die "raw disk is offline: $diskdev"
    mounted="$(lsblk -nrpo NAME,MOUNTPOINT "$diskdev" | awk '$2 != ""')"
    [[ -z "$mounted" ]] || { printf '%s\n' "$mounted" >&2; die "raw disk or a partition is mounted on Linux"; }
    log "raw disk is present and unmounted: $diskdev"
  done
}

check_usb_devices() {
  local item label vid pid missing=0
  for item in "${USB_DEVICES[@]}"; do
    IFS='|' read -r label vid pid <<<"$item"
    if usb_present "$vid" "$pid"; then log "USB present: $label ($vid:$pid)";
    else warn "missing USB: $label ($vid:$pid)"; missing=1; fi
  done
  ((missing == 0)) || die "configured VM USB devices are missing"
}

active_gpu_users() {
  local pci path pids=""
  if [[ "$(read_file "/sys/bus/pci/devices/${GPU_PCI[0]}/vendor")" == "0x10de" ]] \
    && command -v nvidia-smi >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=5s "${NVIDIA_SMI_TIMEOUT}s" nvidia-smi pmon -i "${GPU_PCI[0]}" -c 1 2>/dev/null \
      | awk 'NR > 2 && $2 ~ /^[0-9]+$/ && $2 != "-" {print $2, $5}' || true
  fi
  for pci in "${GPU_PCI[@]}"; do
    for path in /dev/dri/by-path/pci-"${pci#0000:}"-*; do
      [[ -e "$path" ]] || continue
      pids="$(fuser "$path" 2>/dev/null || true)"
      [[ -z "$pids" ]] || printf '%s %s\n' "$pids" "$path"
    done
  done
}

selected_gpu_is_nvidia() {
  [[ "$(read_file "/sys/bus/pci/devices/${GPU_PCI[0]}/vendor")" == "0x10de" ]]
}

verify_nvidia() {
  local summary selected_bus="${GPU_PCI[0]#0000:}"
  selected_gpu_is_nvidia || return 0
  command -v nvidia-smi >/dev/null 2>&1 || return 0
  if ! summary="$(timeout --signal=TERM --kill-after=5s "${NVIDIA_SMI_TIMEOUT}s" \
    nvidia-smi --query-gpu=pci.bus_id,name,driver_version,display_active --format=csv,noheader 2>&1)"; then
    [[ -n "$summary" ]] && printf '%s\n' "$summary" >&2
    die "nvidia-smi could not access the selected GPU; reboot before retrying"
  fi
  [[ -n "$summary" ]] || die "nvidia-smi returned no selected GPU; reboot before retrying"
  grep -qi ":$selected_bus," <<<"$summary" || die "nvidia-smi did not report the selected GPU at $selected_bus"
  log "NVIDIA health: $summary"
}

nvidia_driver_has_other_gpu() {
  local dev pci selected candidate
  for dev in /sys/bus/pci/drivers/nvidia/????:??:??.?; do
    [[ -e "$dev" ]] || continue
    pci="$(basename "$dev")"; selected=0
    for candidate in "${GPU_PCI[@]}"; do [[ "$pci" == "$candidate" ]] && selected=1; done
    ((selected == 0)) && return 0
  done
  return 1
}

unload_gpu_modules() {
  local module
  selected_gpu_is_nvidia || { log "non-NVIDIA GPU selected; libvirt will detach its PCI functions directly."; return 0; }
  warn_if_nvidia_modules_updated_since_boot
  if nvidia_driver_has_other_gpu; then
    log "another host GPU uses the NVIDIA driver; leaving shared NVIDIA modules loaded for libvirt's per-device detach."
    return 0
  fi
  for module in nvidia_drm nvidia_uvm nvidia_modeset nvidia; do
    [[ -d "/sys/module/$module" ]] || continue
    log "unloading module: $module"
    as_root modprobe -r "$module" || die "failed to unload $module; the selected GPU is still in use"
  done
}

warn_if_nvidia_modules_updated_since_boot() {
  local path boot_epoch module_mtime
  selected_gpu_is_nvidia || return 0
  path="$(modinfo -F filename nvidia 2>/dev/null || true)"
  [[ -n "$path" && -e "$path" ]] || return 0
  boot_epoch="$(awk '{printf "%d", systime() - $1}' /proc/uptime 2>/dev/null || true)"
  module_mtime="$(stat -c '%Y' "$path" 2>/dev/null || true)"
  if [[ -n "$boot_epoch" && -n "$module_mtime" ]] && ((module_mtime > boot_epoch)); then
    warn "the on-disk NVIDIA module is newer than this boot; reload may require a reboot"
  fi
}

nvidia_module_diagnostics() {
  local kernel loaded disk vermagic path
  kernel="$(uname -r)"; loaded="$(read_file /sys/module/nvidia/version)"
  disk="$(modinfo -F version nvidia 2>/dev/null || true)"
  vermagic="$(modinfo -F vermagic nvidia 2>/dev/null || true)"
  path="$(modinfo -F filename nvidia 2>/dev/null || true)"
  log "NVIDIA diagnostic: kernel=$kernel loaded=${loaded:-none} disk=${disk:-unknown}"
  log "NVIDIA diagnostic: vermagic=${vermagic:-unknown} module=${path:-unknown}"
}

load_gpu_modules() {
  local module
  warn_if_nvidia_modules_updated_since_boot
  for module in "${GPU_MODULES[@]}"; do
    log "loading module: $module"
    if ! as_root modprobe "$module"; then
      [[ "$module" == nvidia* ]] && nvidia_module_diagnostics
      die "failed to load host GPU module: $module"
    fi
  done
  as_root modprobe snd_hda_intel >/dev/null 2>&1 || true
}

show_linux_input_devices() {
  [[ -r /proc/bus/input/devices ]] || return 0
  printf '%s\n' 'Linux input devices:'
  awk '
    BEGIN {RS=""}
    {
      name=""; handlers=""
      count=split($0, lines, "\n")
      for (i=1; i<=count; i++) {
        if (lines[i] ~ /^N: Name=/) {name=lines[i]; sub(/^N: Name=/, "", name)}
        if (lines[i] ~ /^H: Handlers=/) {handlers=lines[i]; sub(/^H: Handlers=/, "", handlers)}
      }
      if (name != "") printf "  %-48s %s\n", name, handlers
    }
  ' /proc/bus/input/devices
}

wait_for_state() {
  local wanted="$1" timeout_seconds="$2" deadline=$((SECONDS + timeout_seconds)) state
  while ((SECONDS < deadline)); do
    state="$(domstate)" || return 1
    [[ "$state" == "$wanted" ]] && return 0
    sleep 1
  done
  return 1
}

wait_for_vfio() {
  local deadline=$((SECONDS + 30)) pci ready
  while ((SECONDS < deadline)); do
    ready=1
    for pci in "${GPU_PCI[@]}"; do [[ "$(driver_for "$pci")" == "vfio-pci" ]] || ready=0; done
    ((ready == 1)) && return 0
    sleep 1
  done
  return 1
}

_start_windows_mode() {
  local state users pci
  load_runtime_config
  state="$(required_domstate)"
  [[ "$state" == "shut off" ]] || die "$VM is already $state"
  for pci in "${GPU_PCI[@]}"; do
    vm_has_pci_hostdev "$pci" || die "$pci is not a persistent PCI host device in $VM"
    assert_pci_state_sane "$pci"
  done
  check_raw_disks; check_usb_devices
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" && "$ALLOW_GUI" != "1" ]]; then
    die "graphical session detected; run from TTY/SSH or explicitly set ALLOW_GUI=1"
  fi
  begin_root_session
  if systemctl is-active --quiet display-manager.service; then
    log "stopping display-manager to release the selected GPU"
    as_root systemctl stop display-manager.service || die "failed to stop display-manager"
  else log "display-manager is already inactive"; fi
  sleep 2
  if [[ "$(driver_for "${GPU_PCI[0]}")" == "nvidia" ]]; then verify_nvidia; fi
  users="$(active_gpu_users)"
  [[ -z "$users" ]] || { printf '%s\n' "$users" >&2; die "selected GPU still has active users"; }
  unload_gpu_modules
  for pci in "${GPU_PCI[@]}"; do log "$pci pre-start driver: $(driver_for "$pci")"; done
  log "starting $VM"
  virsh -c "$URI" start "$VM" \
    || die "failed to start $VM; run '$SCRIPT_PATH linux' to restore the host desktop"
  wait_for_state running 30 \
    || die "$VM did not reach running state; run '$SCRIPT_PATH linux' to restore the host desktop"
  wait_for_vfio \
    || die "not every selected GPU function reached vfio-pci; run '$SCRIPT_PATH linux' to restore the host desktop"
  for pci in "${GPU_PCI[@]}"; do log "$pci VM driver: $(driver_for "$pci")"; done
  ((${#USB_DEVICES[@]} == 0)) || usb_action attach
  log "$VM is running with the selected GPU"
}

_start_coexist_mode() {
  local state pci started=0
  load_runtime_config
  state="$(required_domstate)"
  case "$state" in
    running) log "$VM is already running" ;;
    "shut off") start_windows_mode; started=1 ;;
    *) die "$VM is $state" ;;
  esac
  wait_for_vfio || die "not every selected GPU function is on vfio-pci"
  for pci in "${GPU_PCI[@]}"; do log "$pci VM driver: $(driver_for "$pci")"; done
  if ((started == 1 && READY_DELAY > 0)); then log "waiting ${READY_DELAY}s before starting display-manager"; sleep "$READY_DELAY"; fi
  if ! systemctl is-active --quiet display-manager.service; then
    begin_root_session
    log "starting Linux display-manager on the remaining host GPU"
    as_root systemctl start display-manager.service || die "failed to start display-manager"
  fi
  systemctl is-active --quiet display-manager.service || die "display-manager did not become active"
  log "Linux + Windows ready: $VM owns the selected GPU and Linux desktop is active"
}

reattach_if_needed() {
  local pci="$1" driver node rc
  driver="$(driver_for "$pci")"; node="$(node_for_pci "$pci")"
  case "$driver" in
    vfio-pci|none)
      log "requesting host reattach for $pci"
      if timeout --signal=TERM --kill-after=5s "${REATTACH_TIMEOUT}s" \
        virsh -c "$URI" nodedev-reattach "$node" >/dev/null 2>&1; then return 0; else rc=$?; fi
      ((rc != 124 && rc != 137)) || die "libvirt timed out reattaching $pci; reboot before retrying"
      log "$pci did not require a libvirt-managed reattach"
      ;;
    *) log "$pci is already host-owned by $driver; skipping libvirt reattach" ;;
  esac
}

_return_linux_mode() {
  local state pci driver primary_driver
  load_runtime_config
  state="$(required_domstate)"
  begin_root_session
  case "$state" in
    running|paused|"in shutdown")
      log "$VM is $state; requesting graceful ACPI shutdown"
      virsh -c "$URI" shutdown "$VM" >/dev/null || die "failed to request graceful shutdown for $VM"
      wait_for_state "shut off" "$SHUTDOWN_TIMEOUT" || die "$VM did not shut down within ${SHUTDOWN_TIMEOUT}s"
      ;;
    "shut off") log "$VM is already shut off" ;;
    *) die "$VM is in unexpected state: $state" ;;
  esac
  for pci in "${GPU_PCI[@]}"; do assert_pci_state_sane "$pci"; done
  for pci in "${GPU_PCI[@]}"; do reattach_if_needed "$pci"; done
  load_gpu_modules
  for pci in "${GPU_PCI[@]}"; do
    driver="$(driver_for "$pci")"
    log "$pci Linux driver: $driver"
    [[ "$driver" != "vfio-pci" ]] || die "$pci is still on vfio-pci; refusing to start the desktop"
  done
  primary_driver="$(driver_for "${GPU_PCI[0]}")"
  [[ "$primary_driver" != "vfio-pci" && "$primary_driver" != "none" ]] \
    || die "selected GPU is still $primary_driver; refusing to start the desktop"
  verify_nvidia
  log "starting display-manager"
  as_root systemctl start display-manager.service || die "failed to start display-manager"
  systemctl is-active --quiet display-manager.service || die "display-manager did not become active"
  log "Linux mode ready"
}

usb_xml_file() {
  local vid="$1" pid="$2"
  USB_XML_FILE="$(mktemp)"; TEMP_FILES+=("$USB_XML_FILE")
  printf '%s\n' \
    "<hostdev mode='subsystem' type='usb' managed='yes'>" \
    '  <source>' "    <vendor id='0x$vid'/>" "    <product id='0x$pid'/>" \
    '  </source>' '</hostdev>' >"$USB_XML_FILE"
}

usb_live_count() {
  local vid="${1,,}" pid="${2,,}" live_xml
  live_xml="$(virsh -c "$URI" dumpxml "$VM")" || die "could not read live XML for $VM"
  usb_live_count_from_xml "$vid" "$pid" "$live_xml"
}

usb_live_count_from_xml() {
  local vid="${1,,}" pid="${2,,}" live_xml="$3"
  xmllint --xpath \
    "count(/domain/devices/hostdev[@type='usb']/source[vendor/@id='0x$vid' and product/@id='0x$pid'])" \
    - 2>/dev/null <<<"$live_xml" || printf '0'
}

_usb_action() {
  local action="$1" state item label vid pid file count output
  [[ "$action" =~ ^(status|xml|attach|detach)$ ]] || die "unknown USB action: $action"
  load_runtime_config
  state="$(required_domstate)"
  if [[ "$action" == "status" ]]; then
    printf 'VM: %s (%s)\n' "$VM" "${state:-unknown}"
    for item in "${USB_DEVICES[@]}"; do
      IFS='|' read -r label vid pid <<<"$item"
      if usb_present "$vid" "$pid"; then printf 'present  %-9s %s\n' "$vid:$pid" "$label"
      else printf 'missing  %-9s %s\n' "$vid:$pid" "$label"; fi
    done
    [[ "$state" == "running" ]] && virsh -c "$URI" qemu-monitor-command "$VM" --hmp 'info usb' 2>/dev/null || true
    show_linux_input_devices
    return 0
  fi
  if [[ "$action" == "xml" ]]; then
    for item in "${USB_DEVICES[@]}"; do
      IFS='|' read -r label vid pid <<<"$item"; usb_xml_file "$vid" "$pid"; file="$USB_XML_FILE"
      printf '%s (%s:%s):\n' "$label" "$vid" "$pid"; cat "$file"
    done
    return 0
  fi
  [[ "$state" == "running" ]] || die "$VM is not running"
  for item in "${USB_DEVICES[@]}"; do
    IFS='|' read -r label vid pid <<<"$item"; usb_xml_file "$vid" "$pid"; file="$USB_XML_FILE"
    case "$action" in
      attach)
        count="$(usb_live_count "$vid" "$pid")"
        if ((count > 0)); then
          log "$label is already attached"
        elif output="$(virsh -c "$URI" attach-device "$VM" "$file" --live 2>&1)"; then
          log "attached $label"
        else
          [[ -z "$output" ]] || printf '%s\n' "$output" >&2
          die "failed to attach $label ($vid:$pid)"
        fi
        ;;
      detach)
        count="$(usb_live_count "$vid" "$pid")"
        if ((count == 0)); then
          log "$label is not attached"
        elif output="$(virsh -c "$URI" detach-device "$VM" "$file" --live 2>&1)"; then
          log "detached $label"
        else
          [[ -z "$output" ]] || printf '%s\n' "$output" >&2
          die "failed to detach $label ($vid:$pid)"
        fi
        ;;
    esac
  done
  udevadm settle --timeout=5 >/dev/null 2>&1 || true
  [[ "$action" == "attach" ]] && virsh -c "$URI" qemu-monitor-command "$VM" --hmp 'info usb' 2>/dev/null || true
}

start_windows_mode() { with_mutation_lock _start_windows_mode; }
start_coexist_mode() { with_mutation_lock _start_coexist_mode; }
return_linux_mode() { with_mutation_lock _return_linux_mode; }
usb_action() {
  case "$1" in
    attach|detach) with_mutation_lock _usb_action "$@" ;;
    *) _usb_action "$@" ;;
  esac
}

_usb_route() {
  local target id vid pid state count label output file live_count
  local -a targets=() ids=()
  declare -A seen=()
  while (($# > 0)); do
    target="$1"; shift
    case "$target" in --linux|--windows) ;; *) die "unknown USB routing argument: $target" ;; esac
    (($# > 0)) || die "$target requires a VID:PID value"
    id="${1,,}"; shift
    [[ "$id" =~ ^[0-9a-f]{4}:[0-9a-f]{4}$ ]] || die "invalid USB VID:PID: $id"
    [[ "${id%:*}" != 1d6b ]] || die "USB root hubs cannot be routed: $id"
    [[ -z "${seen[$id]:-}" ]] || die "USB device was assigned more than once: $id"
    seen[$id]=1; targets+=("${target#--}"); ids+=("$id")
  done
  ((${#ids[@]} > 0)) || die "USB routing requires at least one assignment"

  load_runtime_config
  state="$(required_domstate)"
  [[ "$state" == running ]] || die "$VM is not running; start Windows before changing live USB ownership"

  for id in "${ids[@]}"; do
    vid="${id%:*}"; pid="${id#*:}"; count="$(usb_device_count "$vid" "$pid")"
    usb_id_is_hub "$vid" "$pid" && die "USB hubs cannot be routed: $id"
    ((count == 1)) || {
      if ((count == 0)); then die "USB device is not connected: $id"
      else die "USB device is ambiguous because $count identical devices are connected: $id"; fi
    }
  done

  for ((count=0; count<${#ids[@]}; count++)); do
    id="${ids[$count]}"; target="${targets[$count]}"; vid="${id%:*}"; pid="${id#*:}"
    label="$(usb_label "$vid" "$pid")"; usb_xml_file "$vid" "$pid"; file="$USB_XML_FILE"
    live_count="$(usb_live_count "$vid" "$pid")"
    if [[ "$target" == windows ]]; then
      if ((live_count > 0)); then
        log "$label is already routed to Windows"
      elif output="$(virsh -c "$URI" attach-device "$VM" "$file" --live 2>&1)"; then
        log "routed $label ($id) to Windows"
      else
        [[ -z "$output" ]] || printf '%s\n' "$output" >&2
        die "failed to route $label ($id) to Windows; earlier changes were retained"
      fi
    elif ((live_count == 0)); then
      log "$label is already routed to Linux"
    elif output="$(virsh -c "$URI" detach-device "$VM" "$file" --live 2>&1)"; then
      log "routed $label ($id) to Linux"
    else
      [[ -z "$output" ]] || printf '%s\n' "$output" >&2
      die "failed to route $label ($id) to Linux; earlier changes were retained"
    fi
  done
  udevadm settle --timeout=5 >/dev/null 2>&1 || true
}

usb_route() { with_mutation_lock _usb_route "$@"; }

hardware_report() {
  local dev bdf class
  printf '%s\n' '=== CPU ==='
  lscpu | awk -F: '/^(Model name|Socket\(s\)|Core\(s\) per socket|Thread\(s\) per core|CPU\(s\)|NUMA node\(s\)):/ {gsub(/^[ \t]+/, "", $2); printf "%-24s %s\n", $1, $2}'
  printf '\n%s\n' '=== Display-class PCI devices ==='
  for dev in /sys/bus/pci/devices/*; do
    class="$(<"$dev/class")"; [[ "$class" == 0x03* ]] || continue
    bdf="$(basename "$dev")"
    printf '%s  driver=%-12s iommu=%s  %s\n' "$bdf" "$(driver_for "$bdf")" "$(iommu_group_for "$bdf")" "$(pci_label "$bdf")"
  done
  printf '\n%s\n' '=== Storage ==='; lsblk -d -o NAME,MODEL,SIZE,TRAN,TYPE,STATE
  printf '\n%s\n' '=== USB ==='; if command -v lsusb >/dev/null 2>&1; then lsusb; else printf 'lsusb is unavailable\n'; fi
}

status_report() {
  local pci item label vid pid state
  load_runtime_config; state="$(required_domstate)"
  printf 'VM: %s\nState: %s\nURI: %s\n' "$VM" "${state:-unknown}" "$URI"
  printf 'Raw disks:\n'
  if ((${#VM_RAW_DISKS[@]} == 0)); then printf '  none (file-backed VM)\n'; fi
  for item in "${VM_RAW_DISKS[@]}"; do printf '  %s\n' "$item"; done
  printf 'Display manager: %s\n' "$(systemctl is-active display-manager.service 2>/dev/null || true)"
  printf '\nSelected GPU functions:\n'
  for pci in "${GPU_PCI[@]}"; do
    printf '  %s  driver=%-12s iommu=%s  %s\n' "$pci" "$(driver_for "$pci")" "$(iommu_group_for "$pci")" "$(pci_label "$pci")"
  done
  printf 'Host modules: %s\n' "${GPU_MODULES[*]:-auto/none}"
  printf '\nConfigured USB devices:\n'
  if ((${#USB_DEVICES[@]} == 0)); then printf '  none\n'; fi
  for item in "${USB_DEVICES[@]}"; do
    IFS='|' read -r label vid pid <<<"$item"
    if usb_present "$vid" "$pid"; then printf '  present  %s:%s  %s\n' "$vid" "$pid" "$label"
    else printf '  missing  %s:%s  %s\n' "$vid" "$pid" "$label"; fi
  done
  printf '\nCPU topology:\n'; lscpu | awk -F: '/^(Model name|Socket\(s\)|Core\(s\) per socket|Thread\(s\) per core|CPU\(s\)):/ {gsub(/^[ \t]+/, "", $2); printf "  %-22s %s\n", $1, $2}'
  printf '\nVM vCPU pinning:\n'; virsh -c "$URI" vcpupin "$VM" 2>/dev/null || printf '  unavailable\n'
}

preflight_report() {
  local state pci
  load_runtime_config; state="$(required_domstate)"
  [[ "$state" == "shut off" ]] || die "$VM is $state; preflight expects a stopped VM"
  for pci in "${GPU_PCI[@]}"; do
    vm_has_pci_hostdev "$pci" || die "$pci is not a persistent PCI host device in $VM"
    assert_pci_state_sane "$pci"
    log "$pci is persistent and driver state is consistent ($(driver_for "$pci"))"
  done
  check_raw_disks
  check_usb_devices
  warn_if_nvidia_modules_updated_since_boot
  [[ "$(driver_for "${GPU_PCI[0]}")" != "nvidia" ]] || verify_nvidia
  log "preflight passed for $VM"
}

trim_value() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

machine_disk_record() {
  local disk="$1" exists=no resolved='' state='' mounted=''
  if [[ -e "$disk" ]]; then
    exists=yes
    resolved="$(readlink -f -- "$disk" 2>/dev/null || true)"
    if [[ -b "$resolved" ]]; then
      state="$(lsblk -dnro STATE "$resolved" 2>/dev/null | awk 'NF {print; exit}')"
      mounted="$(lsblk -nrpo NAME,MOUNTPOINT "$resolved" 2>/dev/null | awk '$2 != "" {print}')"
    fi
  fi
  protocol_record disk "$disk" "$resolved" "$exists" "${state:-unknown}" "$mounted"
}

machine_snapshot() {
  local state display pci item label vid pid present attached count index name path
  local temp util memory_used memory_total power vcpus dominfo
  local -A stats=()
  load_runtime_config >/dev/null
  state="$(required_domstate)"
  while IFS='=' read -r name path; do
    [[ -n "$name" ]] && stats["$name"]="$path"
  done < <(virsh -c "$URI" domstats "$VM" --state --cpu-total --vcpu --balloon --interface --block --raw 2>/dev/null || true)
  vcpus="${stats[vcpu.current]:-0}"
  if [[ ! "$vcpus" =~ ^[1-9][0-9]*$ ]]; then
    vcpus="$(virsh -c "$URI" vcpucount "$VM" --config --maximum 2>/dev/null | awk 'NF {print $1; exit}')"
  fi
  memory_used="${stats[balloon.current]:-0}"; memory_total="${stats[balloon.maximum]:-0}"
  if [[ "$memory_total" == 0 ]]; then
    dominfo="$(LC_ALL=C virsh -c "$URI" dominfo "$VM" 2>/dev/null || true)"
    memory_total="$(awk -F: '/^Max memory:/ {gsub(/^[ \t]+/, "", $2); print $2+0; exit}' <<<"$dominfo")"
    [[ "$state" == 'shut off' ]] && memory_used="$memory_total"
  fi

  display="$(systemctl is-active display-manager.service 2>/dev/null || true)"
  protocol_begin
  protocol_record snapshot "$(date +%s)"
  protocol_record vm "$VM" "$state" "$URI" "${vcpus:-0}" \
    "${stats[cpu.time]:-0}" "${memory_used:-0}" "${memory_total:-0}"
  protocol_record display "${display:-unknown}"

  count="${stats[net.count]:-0}"; [[ "$count" =~ ^[0-9]+$ ]] || count=0
  for ((index=0; index<count; index++)); do
    protocol_record vm_net "${stats[net.$index.name]:-$index}" \
      "${stats[net.$index.rx.bytes]:-0}" "${stats[net.$index.tx.bytes]:-0}"
  done
  count="${stats[block.count]:-0}"; [[ "$count" =~ ^[0-9]+$ ]] || count=0
  for ((index=0; index<count; index++)); do
    protocol_record vm_block "${stats[block.$index.name]:-$index}" "${stats[block.$index.path]:-}" \
      "${stats[block.$index.rd.bytes]:-0}" "${stats[block.$index.wr.bytes]:-0}"
  done

  for pci in "${GPU_PCI[@]}"; do
    protocol_record gpu "$pci" "$(driver_for "$pci")" "$(iommu_group_for "$pci")" \
      "$(pci_label "$pci")" "$(read_file "/sys/bus/pci/devices/$pci/vendor")"
  done
  if [[ "$(driver_for "${GPU_PCI[0]}")" == nvidia ]] && command -v nvidia-smi >/dev/null 2>&1; then
    IFS=, read -r temp util memory_used memory_total power < <(
      timeout --signal=TERM --kill-after=2s "${NVIDIA_SMI_TIMEOUT}s" nvidia-smi \
        --id="${GPU_PCI[0]}" --query-gpu=temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw \
        --format=csv,noheader,nounits 2>/dev/null || true
    )
    protocol_record nvidia "$(trim_value "${temp:-}")" "$(trim_value "${util:-}")" \
      "$(trim_value "${memory_used:-}")" "$(trim_value "${memory_total:-}")" "$(trim_value "${power:-}")"
  fi
  for item in "${VM_RAW_DISKS[@]}"; do machine_disk_record "$item"; done
  for item in "${USB_DEVICES[@]}"; do
    IFS='|' read -r label vid pid <<<"$item"
    if usb_present "$vid" "$pid"; then present=yes; else present=no; fi
    attached=no
    if [[ "$state" == running ]] && (( $(usb_live_count "$vid" "$pid") > 0 )); then attached=yes; fi
    protocol_record usb "$label" "$vid" "$pid" "$present" "$attached"
  done
}

usb_is_configured() {
  local want_vid="${1,,}" want_pid="${2,,}" item label vid pid
  for item in "${USB_DEVICES[@]}"; do
    IFS='|' read -r label vid pid <<<"$item"
    [[ "${vid,,}" == "$want_vid" && "${pid,,}" == "$want_pid" ]] && return 0
  done
  return 1
}

machine_inventory() {
  local selected_vm="${1:-${VM:-}}" output domain state dev bdf class group label persistent vendor
  local primary companion item vid pid configured model cpu_count sockets cores threads vcpu cpuset
  local config_exists=no live_xml='' key present owner attached count
  local -a usb_keys=()
  declare -A usb_counts=() usb_labels=() usb_defaults=() usb_hubs=()
  need virsh; need xmllint; need lspci; need lscpu
  [[ -f "$CONFIG_FILE" ]] && config_exists=yes
  if [[ -n "$selected_vm" ]]; then
    virsh -c "$URI" dominfo "$selected_vm" >/dev/null 2>&1 || die "VM was not found at $URI: $selected_vm"
    VM="$selected_vm"
    VM_XML="$(virsh -c "$URI" dumpxml --inactive "$VM")" || die "could not read inactive XML for $VM"
    discover_disks_from_vm
  else
    VM_XML=''
    VM_RAW_DISKS=()
  fi

  protocol_begin
  protocol_record inventory "$(date +%s)" "$selected_vm"
  protocol_record config "$CONFIG_FILE" "$config_exists" "${VM:-}" "$URI"
  output="$(virsh -c "$URI" list --all --name)" || die "could not list libvirt domains at $URI"
  while IFS= read -r domain; do
    [[ -n "$domain" ]] || continue
    state="$(virsh -c "$URI" domstate "$domain" 2>/dev/null || true)"
    protocol_record domain "$domain" "${state:-unknown}"
  done <<<"$output"

  model="$(awk -F: '/^(model name|Hardware)/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo)"
  cpu_count="$(nproc 2>/dev/null || printf 0)"
  sockets="$(lscpu | awk -F: '/^Socket\(s\):/ {gsub(/[ \t]/, "", $2); print $2; exit}')"
  cores="$(lscpu | awk -F: '/^Core\(s\) per socket:/ {gsub(/[ \t]/, "", $2); print $2; exit}')"
  threads="$(lscpu | awk -F: '/^Thread\(s\) per core:/ {gsub(/[ \t]/, "", $2); print $2; exit}')"
  protocol_record cpu "$model" "$cpu_count" "${sockets:-0}" "${cores:-0}" "${threads:-0}"

  for dev in /sys/bus/pci/devices/*; do
    class="$(read_file "$dev/class")"; [[ "$class" == 0x03* ]] || continue
    bdf="$(basename "$dev")"; group="$(iommu_group_for "$bdf")"; label="$(pci_label "$bdf")"
    if [[ -n "$VM_XML" ]] && vm_has_pci_hostdev "$bdf"; then persistent=yes; else persistent=no; fi
    vendor="$(read_file "$dev/vendor")"
    protocol_record gpu "$bdf" "$(driver_for "$bdf")" "$group" "$label" "$persistent" "$vendor"
    primary="${bdf%.*}"
    if [[ "$group" != none && -d "/sys/kernel/iommu_groups/$group/devices" ]]; then
      for companion in "/sys/kernel/iommu_groups/$group/devices/$primary".*; do
        [[ -e "$companion" ]] || continue
        item="$(basename "$companion")"
        if [[ -n "$VM_XML" ]] && vm_has_pci_hostdev "$item"; then persistent=yes; else persistent=no; fi
        protocol_record companion "$bdf" "$item" "$(driver_for "$item")" "$group" \
          "$(pci_label "$item")" "$persistent"
      done
    fi
  done
  for item in "${GPU_PCI[@]}"; do protocol_record selected_gpu "$item"; done

  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    vid="$(<"$dev/idVendor")"; pid="$(<"$dev/idProduct")"; [[ "$vid" != 1d6b ]] || continue
    key="${vid,,}:${pid,,}"
    usb_counts[$key]="$(( ${usb_counts[$key]:-0} + 1 ))"
    [[ -n "${usb_labels[$key]:-}" ]] || usb_labels[$key]="$(usb_label "$vid" "$pid")"
    usb_path_is_hub "$dev" && usb_hubs[$key]=yes
  done
  for item in "${USB_DEVICES[@]}"; do
    protocol_record selected_usb "$item"
    IFS='|' read -r label vid pid <<<"$item"; key="${vid,,}:${pid,,}"
    usb_defaults[$key]=yes
    [[ -n "${usb_labels[$key]:-}" ]] || usb_labels[$key]="$label"
    [[ -n "${usb_counts[$key]:-}" ]] || usb_counts[$key]=0
  done
  if [[ -n "$selected_vm" ]]; then
    state="$(virsh -c "$URI" domstate "$selected_vm" 2>/dev/null || true)"
    [[ "$state" != running ]] || live_xml="$(virsh -c "$URI" dumpxml "$selected_vm")" \
      || die "could not read live XML for $selected_vm"
  fi
  mapfile -t usb_keys < <(printf '%s\n' "${!usb_counts[@]}" | awk 'NF' | sort)
  for key in "${usb_keys[@]}"; do
    vid="${key%:*}"; pid="${key#*:}"; count="${usb_counts[$key]}"
    if [[ -n "${usb_defaults[$key]:-}" ]]; then configured=yes; else configured=no; fi
    [[ -z "${usb_hubs[$key]:-}" || "$configured" == yes ]] || continue
    if ((count > 0)); then
      present=yes
      [[ -n "${usb_hubs[$key]:-}" ]] || \
        protocol_record usb_inventory "${usb_labels[$key]}" "$vid" "$pid" "$configured"
    else
      present=no
    fi
    attached=0
    [[ -z "$live_xml" ]] || attached="$(usb_live_count_from_xml "$vid" "$pid" "$live_xml")"
    if ((attached > 0)); then owner=Windows
    elif [[ "$present" == yes ]]; then owner=Linux
    else owner=Missing; fi
    if [[ -n "${usb_hubs[$key]:-}" ]]; then
      protocol_record usb_route "${usb_labels[$key]}" "$vid" "$pid" "$present" "$configured" "$owner" "$count" no "USB hub"
    else
      protocol_record usb_route "${usb_labels[$key]}" "$vid" "$pid" "$present" "$configured" "$owner" "$count" yes ''
    fi
  done
  for item in "${VM_RAW_DISKS[@]}"; do machine_disk_record "$item"; done

  if [[ -n "$selected_vm" ]]; then
    while read -r vcpu cpuset; do
      [[ "$vcpu" =~ ^[0-9]+$ ]] || continue
      protocol_record pin "$vcpu" "$cpuset"
    done < <(virsh -c "$URI" vcpupin "$selected_vm" 2>/dev/null | awk 'NR > 2 {print $1, $2}')
  fi
  protocol_record timer ready_delay "$READY_DELAY"
  protocol_record timer shutdown_timeout "$SHUTDOWN_TIMEOUT"
  protocol_record timer reattach_timeout "$REATTACH_TIMEOUT"
  protocol_record timer nvidia_smi_timeout "$NVIDIA_SMI_TIMEOUT"
  protocol_record setting allow_gui "$ALLOW_GUI"
}

internal_configure() {
  local selected_vm='' selected_gpu='' arg id vid pid label slot group dev seen_usb='|'
  local -a selected_usb=()
  while (($# > 0)); do
    arg="$1"; shift
    case "$arg" in
      --vm) (($# > 0)) || die "--vm requires a value"; selected_vm="$1"; shift ;;
      --gpu) (($# > 0)) || die "--gpu requires a value"; selected_gpu="${1,,}"; shift ;;
      --usb) (($# > 0)) || die "--usb requires VID:PID"; selected_usb+=("${1,,}"); shift ;;
      *) die "unknown internal configuration argument: $arg" ;;
    esac
  done
  [[ -n "$selected_vm" && -n "$selected_gpu" ]] || die "internal configuration requires --vm and --gpu"
  [[ "$selected_gpu" =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]] || die "invalid GPU PCI address: $selected_gpu"
  [[ -e "/sys/bus/pci/devices/$selected_gpu" ]] || die "GPU PCI function is missing: $selected_gpu"
  [[ "$(read_file "/sys/bus/pci/devices/$selected_gpu/class")" == 0x03* ]] || die "selected PCI function is not a display GPU: $selected_gpu"
  VM="$selected_vm"; virsh -c "$URI" dominfo "$VM" >/dev/null 2>&1 || die "VM was not found at $URI: $VM"
  VM_XML="$(virsh -c "$URI" dumpxml --inactive "$VM")" || die "could not read inactive XML for $VM"
  GPU_PCI=(); slot="${selected_gpu%.*}"; group="$(readlink -f "/sys/bus/pci/devices/$selected_gpu/iommu_group" 2>/dev/null || true)"
  if [[ -d "$group/devices" ]]; then
    for dev in "$group/devices/$slot".*; do [[ -e "$dev" ]] && GPU_PCI+=("$(basename "$dev")"); done
  fi
  ((${#GPU_PCI[@]} > 0)) || GPU_PCI=("$selected_gpu")
  GPU_MODULES=(); infer_gpu_modules
  WIN_DISK=''; discover_disks_from_vm; WIN_DISK="${VM_RAW_DISKS[0]:-}"
  USB_DEVICES=()
  for id in "${selected_usb[@]}"; do
    [[ "$id" =~ ^[0-9a-f]{4}:[0-9a-f]{4}$ ]] || die "invalid USB VID:PID: $id"
    [[ "$seen_usb" != *"|$id|"* ]] || continue
    seen_usb+="$id|"
    vid="${id%:*}"; pid="${id#*:}"; usb_present "$vid" "$pid" || die "selected USB device is not connected: $id"
    label="$(usb_label "$vid" "$pid")"; label="${label//$'\n'/ }"; label="${label//|//}"
    USB_DEVICES+=("$label|$vid|$pid")
  done
  USB_AUTO_DISCOVER=0
  write_config >/dev/null
  protocol_begin
  protocol_record configured "$CONFIG_FILE" "$VM" "${GPU_PCI[*]}" "${#USB_DEVICES[@]}"
}

choose_one() {
  local prompt="$1"; shift; local -a choices=("$@"); local answer index
  ((${#choices[@]} > 0)) || die "no choices available for $prompt"
  printf '\n%s\n' "$prompt"
  for index in "${!choices[@]}"; do printf '  %d) %s\n' "$((index+1))" "${choices[$index]}"; done
  while true; do
    read -rp 'Selection: ' answer
    [[ "$answer" =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= ${#choices[@]})) && { CHOICE_INDEX=$((answer-1)); return 0; }
    printf 'Enter a number from 1 to %d.\n' "${#choices[@]}"
  done
}

_write_config() {
  local tmp item
  tmp="$(mktemp "$ROOT/.vm-helper.env.XXXXXX")"; TEMP_FILES+=("$tmp")
  {
    printf '# Generated interactively by vm-helper. Machine-local; do not commit.\n'
    printf 'VM=%q\nURI=%q\nWIN_DISK=%q\n' "$VM" "$URI" "$WIN_DISK"
    printf 'GPU_PCI=('; for item in "${GPU_PCI[@]}"; do printf ' %q' "$item"; done; printf ' )\n'
    printf 'GPU_MODULES=('; for item in "${GPU_MODULES[@]}"; do printf ' %q' "$item"; done; printf ' )\n'
    printf 'USB_DEVICES=(\n'; for item in "${USB_DEVICES[@]}"; do printf '  %q\n' "$item"; done; printf ')\n'
    printf 'USB_AUTO_DISCOVER=0\nREADY_DELAY=%q\nSHUTDOWN_TIMEOUT=%q\nREATTACH_TIMEOUT=%q\nNVIDIA_SMI_TIMEOUT=%q\nALLOW_GUI=%q\n' \
      "$READY_DELAY" "$SHUTDOWN_TIMEOUT" "$REATTACH_TIMEOUT" "$NVIDIA_SMI_TIMEOUT" "$ALLOW_GUI"
  } >"$tmp"
  if [[ -e "$CONFIG_FILE" ]]; then cp -a "$CONFIG_FILE" "$CONFIG_FILE.bak.$(date +%Y%m%d-%H%M%S)"; fi
  mv "$tmp" "$CONFIG_FILE"; TEMP_FILES=()
  chmod 600 "$CONFIG_FILE"
  log "wrote $CONFIG_FILE"
}

write_config() { with_mutation_lock _write_config; }

configure_interactive() {
  local -a domains=() labels=() bdfs=() usb_items=() usb_labels=()
  local dev bdf class slot group answer selection item vid pid label output persistent seen_usb='|'
  [[ -t 0 ]] || die "configure requires an interactive terminal"
  need virsh; need xmllint; need lspci; need lscpu
  output="$(virsh -c "$URI" list --all --name)" || die "could not list libvirt domains at $URI"
  mapfile -t domains < <(awk 'NF' <<<"$output")
  choose_one 'Select the libvirt VM:' "${domains[@]}"; VM="${domains[$CHOICE_INDEX]}"
  VM_XML="$(virsh -c "$URI" dumpxml --inactive "$VM")" \
    || die "could not read inactive XML for $VM at $URI"

  for dev in /sys/bus/pci/devices/*; do
    class="$(<"$dev/class")"; [[ "$class" == 0x03* ]] || continue
    bdf="$(basename "$dev")"; bdfs+=("$bdf")
    if vm_has_pci_hostdev "$bdf"; then persistent=yes; else persistent=no; fi
    labels+=("$bdf | VM hostdev=$persistent | driver=$(driver_for "$bdf") | IOMMU $(iommu_group_for "$bdf") | $(pci_label "$bdf")")
  done
  choose_one 'Select the GPU to pass through:' "${labels[@]}"; bdf="${bdfs[$CHOICE_INDEX]}"; slot="${bdf%.*}"
  GPU_PCI=()
  group="$(readlink -f "/sys/bus/pci/devices/$bdf/iommu_group" 2>/dev/null || true)"
  if [[ -d "$group/devices" ]]; then
    for dev in "$group"/devices/"$slot".*; do [[ -e "$dev" ]] && GPU_PCI+=("$(basename "$dev")"); done
  fi
  ((${#GPU_PCI[@]} > 0)) || GPU_PCI=("$bdf")
  GPU_MODULES=(); infer_gpu_modules
  printf 'Selected GPU functions:\n'; for item in "${GPU_PCI[@]}"; do printf '  %s %s\n' "$item" "$(pci_label "$item")"; done
  for item in "${GPU_PCI[@]}"; do
    vm_has_pci_hostdev "$item" || warn "$item is not a persistent PCI hostdev in $VM; add it to the VM before a transition"
  done

  discover_disks_from_vm
  WIN_DISK="${VM_RAW_DISKS[0]:-}"
  printf '\nRaw block disks attached to %s:\n' "$VM"
  if ((${#VM_RAW_DISKS[@]} == 0)); then
    printf '  none (file-backed VM)\n'
  else
    for item in "${VM_RAW_DISKS[@]}"; do printf '  %s\n' "$item"; done
  fi

  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    vid="$(<"$dev/idVendor")"; pid="$(<"$dev/idProduct")"; label="$(usb_label "$vid" "$pid")"
    [[ "$vid" != "1d6b" ]] || continue
    [[ "$seen_usb" != *"|$vid:$pid|"* ]] || continue
    seen_usb+="$vid:$pid|"
    usb_items+=("$label|$vid|$pid"); usb_labels+=("$vid:$pid | $label")
  done
  printf '\nConnected USB devices (choose zero or more):\n'
  for selection in "${!usb_labels[@]}"; do printf '  %d) %s\n' "$((selection+1))" "${usb_labels[$selection]}"; done
  read -rp 'USB numbers separated by commas, or blank for none: ' answer
  USB_DEVICES=()
  IFS=',' read -ra selections <<<"$answer"
  for selection in "${selections[@]}"; do
    selection="${selection//[[:space:]]/}"; [[ -z "$selection" ]] && continue
    [[ "$selection" =~ ^[0-9]+$ ]] && ((selection >= 1 && selection <= ${#usb_items[@]})) || die "invalid USB selection: $selection"
    USB_DEVICES+=("${usb_items[$((selection-1))]}")
  done

  printf '\nDetected CPU and current VM pinning:\n'
  lscpu | awk -F: '/^(Model name|CPU\(s\)|Socket\(s\)|Core\(s\) per socket|Thread\(s\) per core):/ {gsub(/^[ \t]+/, "", $2); printf "  %-22s %s\n", $1, $2}'
  virsh -c "$URI" vcpupin "$VM" 2>/dev/null || true
  printf '\nWrite this machine-local configuration to %s? [y/N] ' "$CONFIG_FILE"
  read -r answer; [[ "$answer" =~ ^[Yy]$ ]] || die "configuration cancelled"
  write_config
}

write_worker_metadata() {
  local path="$1" token="$2" pid="$3" action="$4" status="$5" started="$6" finished="$7" rc="$8" log_path="$9"
  local tmp="$path.tmp.$$"
  umask 077
  {
    protocol_begin
    protocol_record action "$token" "$pid" "$action" "$status" "$started" "$finished" "$rc" "$log_path"
  } >"$tmp"
  chmod 600 -- "$tmp"
  mv -f -- "$tmp" "$path"
}

worker_run() {
  local token="$1" action="$2" dir="$3" owner_uid="$4"; shift 4
  [[ "$token" =~ ^[0-9A-Za-z._-]+$ ]] || die "invalid worker token"
  case "$action" in linux|windows|linux-windows|usb-attach|usb-detach|usb-route|check) ;; *) die "invalid worker action: $action" ;; esac
  [[ "$dir" == /* && "$owner_uid" =~ ^[0-9]+$ ]] || die "invalid worker runtime identity"
  [[ "$action" == usb-route || $# == 0 ]] || die "worker action does not accept arguments: $action"
  WORKER_RUNTIME_DIR="$dir"; WORKER_OWNER_UID="$owner_uid"
  ensure_runtime_dir >/dev/null
  case "$action" in
    linux) return_linux_mode ;;
    windows) start_windows_mode ;;
    linux-windows) start_coexist_mode ;;
    usb-attach) usb_action attach ;;
    usb-detach) usb_action detach ;;
    usb-route) usb_route "$@" ;;
    check) preflight_report ;;
  esac
}

worker_supervise() {
  local token="$1" action="$2" dir="$3" owner_uid="$4" started="$5"; shift 5
  local start_path log_path meta_path deadline rc=1 status=failed
  [[ "$token" =~ ^[0-9A-Za-z._-]+$ ]] || die "invalid worker token"
  case "$action" in linux|windows|linux-windows|usb-attach|usb-detach|usb-route|check) ;; *) die "invalid worker action: $action" ;; esac
  [[ "$dir" == /* && "$owner_uid" =~ ^[0-9]+$ && "$owner_uid" == "$UID" && "$started" =~ ^[0-9]+$ ]] \
    || die "invalid worker supervisor identity"
  [[ "$action" == usb-route || $# == 0 ]] || die "worker action does not accept arguments: $action"
  WORKER_RUNTIME_DIR="$dir"; WORKER_OWNER_UID="$owner_uid"
  ensure_runtime_dir >/dev/null
  start_path="$dir/action-$token.start"; log_path="$dir/action-$token.log"; meta_path="$dir/action-$token.meta"
  deadline=$((SECONDS + 5))
  while [[ ! -e "$start_path" ]]; do
    ((SECONDS < deadline)) || die "worker launch handshake timed out"
    command sleep 0.02
  done
  rm -f -- "$start_path"
  if [[ "$action" == check ]]; then
    log "starting detached read-only worker"
    if setsid "$SCRIPT_PATH" __worker-run "$token" "$action" "$dir" "$owner_uid" "$@"; then rc=0; else rc=$?; fi
  elif ((EUID == 0)); then
    log "starting detached privileged worker"
    if setsid "$SCRIPT_PATH" __worker-run "$token" "$action" "$dir" "$owner_uid" "$@"; then rc=0; else rc=$?; fi
  else
    log "sudo authorized on launcher TTY; starting detached privileged worker"
    if sudo -n setsid "$SCRIPT_PATH" __worker-run "$token" "$action" "$dir" "$owner_uid" "$@"; then rc=0; else rc=$?; fi
  fi
  ((rc == 0)) && status=complete
  write_worker_metadata "$meta_path" "$token" "$$" "$action" "$status" \
    "$started" "$(date +%s)" "$rc" "$log_path"
  return "$rc"
}

worker_start() {
  local action="$1"; shift
  local dir token log_path meta_path start_path lock_path pid owner_uid started
  case "$action" in linux|windows|linux-windows|usb-attach|usb-detach|usb-route|check) ;; *) die "invalid worker action: $action" ;; esac
  [[ "$action" == usb-route || $# == 0 ]] || die "worker action does not accept arguments: $action"
  if [[ "$action" == usb-route ]]; then
    local arg expect_id=0 assignment_count=0
    for arg in "$@"; do
      if ((expect_id)); then
        [[ "${arg,,}" =~ ^[0-9a-f]{4}:[0-9a-f]{4}$ ]] || die "invalid USB VID:PID: $arg"
        [[ "${arg,,}" != 1d6b:* ]] || die "USB root hubs cannot be routed: $arg"
        expect_id=0; ((assignment_count += 1))
      else
        [[ "$arg" == --linux || "$arg" == --windows ]] || die "unknown USB routing argument: $arg"
        expect_id=1
      fi
    done
    ((expect_id == 0 && assignment_count > 0)) || die "USB routing requires complete assignments"
  fi
  need nohup; need setsid
  if [[ "$action" != check && EUID -ne 0 ]]; then
    need sudo
    sudo -n true 2>/dev/null \
      || die "sudo authorization expired before worker launch; select the action again to authorize"
  fi
  dir="$(ensure_runtime_dir)"; token="$(date +%Y%m%d%H%M%S)-$$-$RANDOM"
  owner_uid="$UID"; started="$(date +%s)"
  log_path="$dir/action-$token.log"; meta_path="$dir/action-$token.meta"
  start_path="$dir/action-$token.start"; lock_path="$dir/mutation.lock"
  umask 077; : >"$log_path"; chmod 600 -- "$log_path"
  if [[ "$action" != check ]]; then : >>"$lock_path"; chmod 600 -- "$lock_path"; fi
  nohup "$SCRIPT_PATH" __worker-supervise "$token" "$action" "$dir" "$owner_uid" "$started" "$@" \
    </dev/null >>"$log_path" 2>&1 &
  pid=$!
  write_worker_metadata "$meta_path" "$token" "$pid" "$action" running "$started" '' '' "$log_path"
  : >"$start_path"; chmod 600 -- "$start_path"
  protocol_begin
  protocol_record worker "$token" "$pid" "$action" "$log_path" "$meta_path"
}

tui_available() {
  [[ "${VM_HELPER_TUI:-1}" != 0 && "${TERM:-dumb}" != dumb && -t 0 && -t 1 ]] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -c 'import curses; curses.setupterm()' >/dev/null 2>&1
}

launch_tui() {
  local mode="${1:-dashboard}"
  PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m vm_helper_tui \
    --backend "$SCRIPT_PATH" --mode "$mode"
}

usage() {
  cat <<EOF
Usage: $(basename "$SCRIPT_PATH") [command]

Commands:
  menu                 Monitoring TUI (default on a terminal)
  classic-menu         Classic Bash menu fallback
  linux                Host owns selected devices; start Linux desktop
  windows              Start Windows VM with selected devices; leave Linux at TTY
  linux-windows        Start Windows VM, then start Linux desktop
  status               VM, GPU, USB, disk, CPU topology and vCPU pinning
  check                Read-only transition preflight
  hardware             Discover host CPU, GPUs, IOMMU groups, disks and USB
  configure            Full-screen machine-local configuration wizard
  configure-classic    Classic Bash configuration wizard fallback
  usb status           Show configured USB and live VM USB state
  usb xml              Print generated USB hostdev XML without changing state
  usb attach           Live-attach configured USB devices
  usb detach           Live-detach configured USB devices
  help                 Show this help

Aliases: coexist and both mean linux-windows. Legacy entrypoints windows4090,
linux4090, linux-vm, linuxvm, usb-vm-helper and vm-gpu-manager resolve here.
Set VM_HELPER_TUI=0 to use classic Bash interaction by default.
EOF
}

confirm() {
  local answer
  read -rp "$1 [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]]
}

run_menu_action() {
  local rc
  set +e
  (set -Eeuo pipefail; "$@")
  rc=$?
  set -e
  ((rc == 0)) || warn "action failed with status $rc"
  return 0
}

read_main_menu_choice() {
  local -a labels=(
    'Linux'
    'Windows'
    'Linux + Windows'
    'Validate'
    'USB'
    'Configure'
    'Quit'
  )
  local -a values=(1 2 3 4 5 6 7)
  local selected=0 key suffix next index

  printf '\033[s'
  while true; do
    printf '\nVM Helper\n'
    for index in "${!labels[@]}"; do
      if ((index == selected)); then
        printf ' \033[7m%2s) %s\033[0m\n' "${values[$index]}" "${labels[$index]}"
      else
        printf ' %2s) %s\n' "${values[$index]}" "${labels[$index]}"
      fi
    done
    printf '\nUp/Down: navigate   Enter: select   Number: choose\n'

    IFS= read -rsn1 key || return 1
    case "$key" in
      $'\e')
        suffix=''
        IFS= read -rsn2 -t 0.15 suffix || true
        case "$suffix" in
          '[A') selected=$(((selected - 1 + ${#labels[@]}) % ${#labels[@]})) ;;
          '[B') selected=$(((selected + 1) % ${#labels[@]})) ;;
          *) continue ;;
        esac
        ;;
      '')
        MENU_CHOICE="${values[$selected]}"
        return 0
        ;;
      [0-9])
        MENU_CHOICE="$key"
        return 0
        ;;
      k) selected=$(((selected - 1 + ${#labels[@]}) % ${#labels[@]})) ;;
      j) selected=$(((selected + 1) % ${#labels[@]})) ;;
      *) continue ;;
    esac
    printf '\033[u\033[J'
  done
}

interactive_usb_menu() {
  local answer
  while true; do
    printf '\nLive USB\n  1) Status\n  2) Configured devices -> Windows\n  3) Configured devices -> Linux\n  4) Back\nSelection: '
    read -r answer
    case "$answer" in
      1) run_menu_action usb_action status ;;
      2) if confirm 'Attach configured USB devices to Windows?'; then run_menu_action usb_action attach; fi ;;
      3) if confirm 'Detach configured USB devices back to Linux?'; then run_menu_action usb_action detach; fi ;;
      4|'') return 0 ;;
      *) printf 'Enter a number from 1 to 4.\n' ;;
    esac
  done
}

interactive_menu() {
  local choice
  while true; do
    read_main_menu_choice || return 0
    choice="$MENU_CHOICE"
    printf '\n'
    case "$choice" in
      1) if confirm 'Shut down the VM, return its devices to Linux, and start the desktop?'; then run_menu_action return_linux_mode; fi ;;
      2) if confirm 'Start Windows with the selected devices and leave Linux at TTY?'; then run_menu_action start_windows_mode; fi ;;
      3) if confirm 'Start Windows with the selected devices, then start the Linux desktop?'; then run_menu_action start_coexist_mode; fi ;;
      4) run_menu_action preflight_report ;;
      5) interactive_usb_menu ;;
      6) run_menu_action configure_interactive ;;
      7|0) return 0 ;;
      *) printf 'Unknown selection.\n' ;;
    esac
  done
}

dispatch() {
  local command="${1:-}" usb_command
  case "$ENTRYPOINT" in
    windows4090) command=windows ;;
    linux4090) command=linux ;;
    linux-vm|linuxvm) command=coexist ;;
    usb-vm-helper)
      usb_command="${1:-status}"
      case "$usb_command" in to-vm) usb_command=attach ;; to-linux) usb_command=detach ;; esac
      usb_action "$usb_command"; return
      ;;
    win-input-status.sh) usb_action status; return ;;
    win-input-to-vm.sh) usb_action attach; return ;;
    win-input-to-linux.sh) usb_action detach; return ;;
  esac
  if [[ -z "$command" ]]; then [[ -t 0 ]] && command=menu || command=help; fi
  case "$command" in
    menu)
      if tui_available; then launch_tui dashboard
      else warn 'curses TUI unavailable; using the classic Bash menu'; interactive_menu; fi
      ;;
    classic-menu) interactive_menu ;;
    status) status_report ;;
    check|preflight) preflight_report ;;
    hardware|discover) hardware_report ;;
    configure|config)
      if tui_available; then launch_tui configure
      else warn 'curses TUI unavailable; using the classic Bash wizard'; configure_interactive; fi
      ;;
    configure-classic) configure_interactive ;;
    windows|vm) start_windows_mode ;;
    linux-windows|coexist|both|linux-vm) start_coexist_mode ;;
    linux|host) return_linux_mode ;;
    usb) usb_action "${2:-status}" ;;
    machine)
      case "${2:-}" in
        snapshot) machine_snapshot ;;
        inventory) machine_inventory "${3:-}" ;;
        configure) shift 2; internal_configure "$@" ;;
        worker-start)
          [[ -n "${3:-}" ]] || die 'worker-start requires an action'
          command="$3"; shift 3; worker_start "$command" "$@"
          ;;
        *) die "unknown machine endpoint: ${2:-}" ;;
      esac
      ;;
    __worker-supervise)
      [[ -n "${2:-}" && -n "${3:-}" && -n "${4:-}" && -n "${5:-}" && -n "${6:-}" ]] \
        || die 'invalid worker supervisor invocation'
      worker_supervise "$2" "$3" "$4" "$5" "$6" "${@:7}"
      ;;
    __worker-run)
      [[ -n "${2:-}" && -n "${3:-}" && -n "${4:-}" && -n "${5:-}" ]] \
        || die 'invalid worker invocation'
      worker_run "$2" "$3" "$4" "$5" "${@:6}"
      ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  dispatch "$@"
fi
