#!/usr/bin/env python3
"""Harmless protocol backend used by TUI and detached-worker tests."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import time


def encoded(records: list[tuple[str, tuple[object, ...]]]) -> bytes:
    result = bytearray(b"VMH1\0")
    for kind, fields in records:
        result.extend(kind.encode() + b"\0" + str(len(fields)).encode() + b"\0")
        for field in fields:
            result.extend(str(field).encode() + b"\0")
    return bytes(result)


def runtime_dir() -> Path:
    return Path(os.environ["XDG_RUNTIME_DIR"]) / "vm-helper"


def write_meta(token: str, pid: int, action: str, status: str, started: int,
               finished: object = "", returncode: object = "") -> Path:
    directory = runtime_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    log = directory / f"action-{token}.log"
    meta = directory / f"action-{token}.meta"
    temporary = meta.with_suffix(".tmp")
    temporary.write_bytes(encoded([("action", (token, pid, action, status, started, finished, returncode, log))]))
    temporary.chmod(0o600)
    temporary.replace(meta)
    return meta


def worker(token: str, action: str, started: int) -> int:
    directory = runtime_dir()
    log = directory / f"action-{token}.log"
    write_meta(token, os.getpid(), action, "running", started)
    with log.open("a", encoding="utf-8") as handle:
        handle.write(f"fake {action} started\n")
        handle.flush()
        time.sleep(0.4)
        handle.write("fake action complete\n")
    write_meta(token, os.getpid(), action, "complete", started, int(time.time()), 0)
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args[:1] == ["__worker"]:
        return worker(args[1], args[2], int(args[3]))
    if args[:2] == ["machine", "snapshot"]:
        time.sleep(float(os.environ.get("VM_HELPER_FAKE_DELAY", "0")))
        sys.stdout.buffer.write(encoded([
            ("snapshot", (int(time.time()),)),
            ("vm", ("test-windows", "shut off", "qemu:///test", 8, 0, 0, 16 * 1024 * 1024)),
            ("display", ("active",)),
            ("gpu", ("0000:01:00.0", "nvidia", 13, "Fake GPU", "0x10de")),
            ("disk", ("/dev/fake raw disk", "/dev/fake", "yes", "live", "")),
            ("usb", ("Keyboard | safe label", "1234", "abcd", "yes", "no")),
        ]))
        return 0
    if args[:2] == ["machine", "inventory"]:
        time.sleep(float(os.environ.get("VM_HELPER_FAKE_DELAY", "0")))
        sys.stdout.buffer.write(encoded([
            ("inventory", (int(time.time()), args[2] if len(args) > 2 else "")),
            ("config", ("/tmp/vm-helper.env", "no", "", "qemu:///test")),
            ("domain", ("test-windows", "shut off")),
            ("cpu", ("Fake CPU", 8, 1, 4, 2)),
            ("gpu", ("0000:01:00.0", "nvidia", 13, "Fake GPU", "yes", "0x10de")),
            ("companion", ("0000:01:00.0", "0000:01:00.1", "snd_hda_intel", 13, "Fake Audio", "yes")),
            ("usb_inventory", ("Keyboard | safe label", "1234", "abcd", "yes")),
            ("disk", ("/dev/fake raw disk", "/dev/fake", "yes", "live", "")),
            ("pin", (0, "0-3")),
            ("timer", ("ready_delay", 1)),
        ]))
        return 0
    if args[:2] == ["machine", "configure"]:
        sys.stdout.buffer.write(encoded([("configured", ("/tmp/vm-helper.env", "test-windows", "0000:01:00.0", 1))]))
        return 0
    if args[:2] == ["machine", "worker-start"]:
        directory = runtime_dir()
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        token = f"fake-{time.time_ns()}"; action = args[2]; started = int(time.time())
        log = directory / f"action-{token}.log"; log.touch(mode=0o600)
        process = subprocess.Popen(
            [sys.executable, __file__, "__worker", token, action, str(started)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        meta = write_meta(token, process.pid, action, "running", started)
        sys.stdout.buffer.write(encoded([("worker", (token, process.pid, action, log, meta))]))
        return 0
    print("unsupported fake invocation", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
