#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
if [[ -f "$ROOT/vm-helper.env" ]]; then
  source "$ROOT/vm-helper.env"
fi

VM="${VM:-win11-basic}"
URI="${URI:-qemu:///system}"
WIN_DISK="${WIN_DISK:-}"
ALLOW_GUI="${ALLOW_GUI:-0}"
if ! declare -p GPU_PCI >/dev/null 2>&1; then
  GPU_PCI=("0000:01:00.0" "0000:01:00.1")
fi
if ! declare -p REQUIRED_USB >/dev/null 2>&1; then
  REQUIRED_USB=(
    "Wooting 60HE|31e3|1312"
    "Logitech G305 receiver|046d|c53f"
    "SteelSeries Nova Pro Wireless|1038|12e5"
  )
fi

log() {
  printf '[windows4090] %s\n' "$*"
}

die() {
  printf '[windows4090] ERROR: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

as_root() {
  if (( EUID == 0 )); then
    "$@"
  else
    sudo "$@"
  fi
}

domstate() {
  virsh -c "$URI" domstate "$VM" 2>/dev/null || true
}

driver_for() {
  local pci="$1"
  local link="/sys/bus/pci/devices/$pci/driver"
  if [[ -L "$link" ]]; then
    basename "$(readlink -f "$link")"
  else
    printf 'none'
  fi
}

mounted_children_for() {
  local diskdev="$1"
  lsblk -nrpo NAME,MOUNTPOINT "$diskdev" 2>/dev/null | awk '$2 != "" {print $0}'
}

block_state_for() {
  local diskdev="$1"
  lsblk -dnro STATE "$diskdev" 2>/dev/null | awk 'NF {print $1; exit}'
}

active_nvidia_pids() {
  command -v nvidia-smi >/dev/null 2>&1 || return 0
  nvidia-smi >/dev/null 2>&1 || return 0
  nvidia-smi pmon -c 1 2>/dev/null \
    | awk 'NR > 2 && $2 ~ /^[0-9]+$/ && $2 != "-" {print $2, $5}' \
    | sort -u
}

usb_present() {
  local want_vid="$1"
  local want_pid="$2"
  local dev vid pid
  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    vid="$(<"$dev/idVendor")"
    pid="$(<"$dev/idProduct")"
    [[ "$vid" == "$want_vid" && "$pid" == "$want_pid" ]] && return 0
  done
  return 1
}

check_required_usb() {
  local missing=0 item label vid pid
  for item in "${REQUIRED_USB[@]}"; do
    IFS='|' read -r label vid pid <<<"$item"
    if usb_present "$vid" "$pid"; then
      log "USB present: $label ($vid:$pid)"
    else
      printf '[windows4090] missing USB: %s (%s:%s)\n' "$label" "$vid" "$pid" >&2
      missing=1
    fi
  done
  (( missing == 0 )) || die "required Windows USB devices are missing. Switch the hardware KVM/plug devices into Linux, then rerun."
}

need virsh
need systemctl
need lspci
need lsblk
need readlink

if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" && "$ALLOW_GUI" != "1" ]]; then
  die "graphical session detected. Run this from a TTY/SSH, or set ALLOW_GUI=1 if you accept that stopping display-manager may kill this shell."
fi

state="$(domstate)"
case "$state" in
  running|paused|"in shutdown")
    die "$VM is already $state. Use linux4090 to shut it down cleanly before starting again."
    ;;
  "shut off"|"")
    log "$VM is shut off and can be started."
    ;;
  *)
    die "$VM is in unexpected state: $state"
    ;;
esac

[[ -n "$WIN_DISK" ]] || die "WIN_DISK is not configured. Copy vm-helper.env.example to vm-helper.env and set a stable /dev/disk/by-id path."
[[ -e "$WIN_DISK" ]] || die "Windows raw disk is missing: $WIN_DISK"
diskdev="$(readlink -f "$WIN_DISK")"
[[ -b "$diskdev" ]] || die "Windows raw disk did not resolve to a block device: $WIN_DISK -> $diskdev"

disk_state="$(block_state_for "$diskdev")"
if [[ "$disk_state" == "offline" ]]; then
  die "Windows raw disk is present but offline: $diskdev. Power-cycle/replug the USB-C NVMe before starting the VM."
fi

mounted="$(mounted_children_for "$diskdev" || true)"
if [[ -n "$mounted" ]]; then
  printf '%s\n' "$mounted" >&2
  die "Windows disk or one of its partitions is mounted on Linux. Unmount it before starting the VM."
fi
log "Windows disk is present and not mounted on Linux: $diskdev"

check_required_usb

if systemctl is-active --quiet display-manager; then
  log "stopping display-manager to release the 4090."
  as_root systemctl stop display-manager
else
  log "display-manager is already inactive."
fi

sleep 2

gpu_users="$(active_nvidia_pids || true)"
if [[ -n "$gpu_users" ]]; then
  printf '%s\n' "$gpu_users" >&2
  die "NVIDIA still has active users. Stop those processes before starting $VM."
fi

for pci in "${GPU_PCI[@]}"; do
  log "$pci pre-start driver: $(driver_for "$pci")"
done

log "starting $VM."
virsh -c "$URI" start "$VM"

for _ in {1..30}; do
  [[ "$(domstate)" == "running" ]] && break
  sleep 1
done

[[ "$(domstate)" == "running" ]] || die "$VM did not reach running state."

for pci in "${GPU_PCI[@]}"; do
  log "$pci post-start driver: $(driver_for "$pci")"
done

if [[ "$(driver_for 0000:01:00.0)" != "vfio-pci" ]]; then
  die "4090 GPU did not bind to vfio-pci after VM start."
fi

log "$VM is running. Switch the monitor/input path to the 4090/Windows side."
virsh -c "$URI" qemu-monitor-command "$VM" --hmp 'info usb' 2>/dev/null || true
